<UserControl x:Class="PapJoaoSimoes.Views.ContasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="940">
    <UserControl.Resources>
        <Style x:Key="AccountInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="AccountPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#278B59" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#21784C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountSecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource AccountPrimaryButtonStyle}">
            <Setter Property="Background" Value="#EEF2F0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E2E9E6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccountIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="#E8F4EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Contas administradoras" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding TotalContas}" />
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    Command="{Binding NovaContaCommand}"
                    Click="NovaContaButton_Click"
                    Style="{StaticResource AccountPrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="White"
                               Text="&#xE710;" />
                    <TextBlock VerticalAlignment="Center" Foreground="White" Text="Nova conta" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="6">
                <Grid>
                    <DataGrid x:Name="ContasDataGrid"
                              ItemsSource="{Binding Contas}"
                              SelectedItem="{Binding ContaSelecionada}"
                              Style="{StaticResource AppTableDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource AppTableColumnHeaderStyle}"
                              RowStyle="{StaticResource AppTableRowStyle}"
                              CellStyle="{StaticResource AppTableCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*" MinWidth="140" Header="UTILIZADOR">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding NomeUtilizador}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding UltimoAcesso, StringFormat={}{0:dd/MM/yyyy HH:mm}, TargetNullValue=Nunca iniciou sessão}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="88" Header="ESTADO" HeaderStyle="{StaticResource AppTableCenteredColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="StatusBadge"
                                                Padding="8,4"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#F1F3F2"
                                                CornerRadius="4">
                                            <TextBlock x:Name="StatusText"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#6C7773"
                                                       Text="Inativa" />
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                <Setter TargetName="StatusBadge" Property="Background" Value="#E3F3EA" />
                                                <Setter TargetName="StatusText" Property="Foreground" Value="#247348" />
                                                <Setter TargetName="StatusText" Property="Text" Value="Ativa" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="82" Header="AÇÕES" HeaderStyle="{StaticResource AppTableCenteredColumnHeaderStyle}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                            <Button Command="{Binding DataContext.EditarContaCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Click="EditarContaButton_Click"
                                                    Style="{StaticResource AccountIconButtonStyle}"
                                                    ToolTip="Editar conta">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           Text="&#xE70F;" />
                                            </Button>
                                            <Button Click="EliminarContaButton_Click"
                                                    Style="{StaticResource AccountIconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="Eliminar conta">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14"
                                                           Foreground="#C94F4F"
                                                           Text="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#FCFDFC"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="5">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="&#xE77B;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{Binding TituloFormulario}" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="Acesso de administrador" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Padding="10,8" Margin="0,0,0,14" CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Background" Value="#E5F4EB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mensagem}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mensagem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                        <Setter Property="Background" Value="#FCEBEC" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11.5" Text="{Binding Mensagem}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#247348" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                            <Setter Property="Foreground" Value="#A43B3B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <ScrollViewer Grid.Row="3"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource AccountLabelStyle}" Text="Nome de utilizador *" />
                            <TextBox MaxLength="50"
                                     Style="{StaticResource AccountInputStyle}"
                                     Text="{Binding ContaEmEdicao.NomeUtilizador, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,15,0,6"
                                       Style="{StaticResource AccountLabelStyle}"
                                       Text="Password" />
                            <PasswordBox x:Name="PasswordInput"
                                         Style="{StaticResource AccountPasswordStyle}" />

                            <TextBlock Margin="0,13,0,6"
                                       Style="{StaticResource AccountLabelStyle}"
                                       Text="Confirmar password" />
                            <PasswordBox x:Name="ConfirmarPasswordInput"
                                         Style="{StaticResource AccountPasswordStyle}" />

                            <TextBlock Margin="0,7,0,0"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding AjudaPassword}"
                                       TextWrapping="Wrap" />

                            <CheckBox Margin="0,18,0,0"
                                      Content="Conta ativa"
                                      IsChecked="{Binding ContaEmEdicao.Ativo}"
                                      IsEnabled="{Binding PodeAlterarEstado}"
                                      FontSize="12"
                                      FontWeight="SemiBold" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Command="{Binding NovaContaCommand}"
                                Click="NovaContaButton_Click"
                                Content="Limpar"
                                Style="{StaticResource AccountSecondaryButtonStyle}" />
                        <Button Grid.Column="2"
                                Click="GuardarContaButton_Click"
                                Content="Guardar"
                                Style="{StaticResource AccountPrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
