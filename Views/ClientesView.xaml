<UserControl x:Class="PapJoaoSimoes.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="940">
    <UserControl.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#FCFDFC" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="InputBorder" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="#EFF3F1" />
                                <Setter Property="Foreground" Value="#87938F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#278B59" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#21784C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#173A31" />
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#AFCBC0" />
                                <Setter Property="Foreground" Value="#EDF5F1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#EEF2F0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E2E9E6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TableIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="#E8F4EE" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="IconBackground" Property="Background" Value="#DDEFE6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    Background="White"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <TextBlock x:Name="CheckIcon"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="White"
                                           Text="&#xE73E;"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#173A31" />
                                <Setter TargetName="CheckBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock FontSize="17" FontWeight="SemiBold" Text="Lista de clientes" />
                <TextBlock x:Name="TotalClientesText"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding TotalClientes}" />
            </StackPanel>

            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                <Border x:Name="PesquisaContainer"
                        Width="250"
                        Height="40"
                        Margin="0,0,10,0"
                        Background="White"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="&#xE721;" />
                        <TextBox x:Name="PesquisaTextBox"
                                 Grid.Column="1"
                                 Padding="0,0,8,0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="12"
                                 Text="{Binding TextoPesquisa, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Pesquisar por nome, NIF ou contacto" />
                        <TextBlock Grid.Column="1"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   FontSize="12"
                                   Foreground="#8A9692"
                                   Text="Pesquisar clientes...">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=PesquisaTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <ComboBox x:Name="EstadoFiltroComboBox"
                          AutomationProperties.Name="Filtrar clientes por estado"
                          AutomationProperties.HelpText="Mostra todos os clientes ou apenas clientes ativos ou inativos"
                          Width="120"
                          Height="40"
                          Margin="0,0,10,0"
                          Padding="10,0"
                          VerticalContentAlignment="Center"
                          Background="White"
                          BorderBrush="{DynamicResource BorderBrush}"
                          FontSize="12"
                          ToolTip="Filtrar por estado"
                          ItemsSource="{Binding EstadosFiltro}"
                          SelectedItem="{Binding EstadoSelecionado}" />

                <Button x:Name="NovoClienteButton"
                        Command="{Binding NovoClienteCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Foreground="White"
                                   Text="&#xE710;" />
                        <TextBlock VerticalAlignment="Center" Foreground="White" Text="Novo cliente" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="FormularioColumn" Width="326" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                <DataGrid x:Name="ClientesDataGrid"
                          ItemsSource="{Binding ClientesFiltrados}"
                          SelectedItem="{Binding ClienteSelecionado}"
                          Style="{StaticResource AppTableDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource AppTableColumnHeaderStyle}"
                          RowStyle="{StaticResource AppTableRowStyle}"
                          CellStyle="{StaticResource AppTableCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="CodigoColumn" Width="72" Binding="{Binding ClienteId}" Header="CÓDIGO" ElementStyle="{StaticResource AppTableCenteredTextStyle}" HeaderStyle="{StaticResource AppTableCenteredColumnHeaderStyle}" />
                        <DataGridTextColumn x:Name="ClienteColumn" Width="250" MinWidth="170" Binding="{Binding Nome}" Header="CLIENTE" />
                        <DataGridTextColumn x:Name="NifColumn" Width="100" Binding="{Binding Nif}" Header="NIF" />
                        <DataGridTextColumn x:Name="TelemovelColumn" Width="115" Binding="{Binding Telemovel}" Header="TELEMÓVEL" />
                        <DataGridTextColumn x:Name="EmailColumn" Width="250" MinWidth="190" Binding="{Binding Email}" Header="EMAIL" />
                        <DataGridTemplateColumn x:Name="EstadoColumn" Width="92" Header="ESTADO" HeaderStyle="{StaticResource AppTableCenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border x:Name="StatusBadge"
                                            Padding="9,4"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#F1F3F2"
                                            CornerRadius="4">
                                        <TextBlock x:Name="StatusText"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#6C7773"
                                                   Text="Inativo" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Ativo}" Value="True">
                                            <Setter TargetName="StatusBadge" Property="Background" Value="#E3F3EA" />
                                            <Setter TargetName="StatusText" Property="Foreground" Value="#247348" />
                                            <Setter TargetName="StatusText" Property="Text" Value="Ativo" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="AcoesColumn" Width="88" Header="AÇÕES" HeaderStyle="{StaticResource AppTableCenteredColumnHeaderStyle}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button Style="{StaticResource TableIconButtonStyle}"
                                                Command="{Binding DataContext.EditarClienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                ToolTip="Editar cliente">
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="&#xE70F;" />
                                        </Button>
                                        <Button Command="{Binding DataContext.DesativarClienteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#C94F4F"
                                                ToolTip="Desativar cliente">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource TableIconButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ativo}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="#C94F4F"
                                                       Text="&#xE711;" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasItems, ElementName=ClientesDataGrid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="24"
                                   Foreground="#88A399"
                                   Text="&#xE77B;" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Nenhum cliente encontrado" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="Altera a pesquisa ou regista um novo cliente." />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="#FCFDFC"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    CornerRadius="5">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="&#xE77B;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FormTitleText"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding FormTitle}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="Dados principais do cliente" />
                            </StackPanel>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="10,8"
                            Margin="0,0,0,14"
                            CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Background" Value="#E5F4EB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MensagemCliente}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                        <Setter Property="Background" Value="#FCEBEC" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="11.5"
                                   Text="{Binding MensagemCliente}"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#247348" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MensagemEhErro}" Value="True">
                                            <Setter Property="Foreground" Value="#A43B3B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <ScrollViewer Grid.Row="3"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">

                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Nome *" />
                            <TextBox x:Name="NomeTextBox"
                                     Style="{StaticResource InputStyle}"
                                     MaxLength="100"
                                     Text="{Binding ClienteEmEdicao.Nome, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,14,0,6" Style="{StaticResource FormLabelStyle}" Text="NIF *" />
                            <TextBox x:Name="NifTextBox"
                                     Style="{StaticResource InputStyle}"
                                     MaxLength="9"
                                     Text="{Binding ClienteEmEdicao.Nif, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,14,0,6" Style="{StaticResource FormLabelStyle}" Text="Telemóvel" />
                            <TextBox x:Name="TelemovelTextBox"
                                     Style="{StaticResource InputStyle}"
                                     MaxLength="20"
                                     Text="{Binding ClienteEmEdicao.Telemovel, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,14,0,6" Style="{StaticResource FormLabelStyle}" Text="Email" />
                            <TextBox x:Name="EmailTextBox"
                                     Style="{StaticResource InputStyle}"
                                     MaxLength="255"
                                     Text="{Binding ClienteEmEdicao.Email, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,14,0,6" Style="{StaticResource FormLabelStyle}" Text="Morada" />
                            <TextBox x:Name="MoradaTextBox"
                                     Height="72"
                                     Padding="11,8"
                                     Style="{StaticResource InputStyle}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalContentAlignment="Top"
                                     MaxLength="255"
                                     Text="{Binding ClienteEmEdicao.Morada, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox x:Name="AtivoCheckBox"
                                      Margin="0,18,0,0"
                                      Style="{StaticResource ModernCheckBoxStyle}"
                                      IsChecked="{Binding ClienteEmEdicao.Ativo}"
                                      Content="Cliente ativo" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LimparFormularioButton"
                                Grid.Column="0"
                                Command="{Binding LimparFormularioCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Content="Limpar" />
                        <Button x:Name="GuardarClienteButton"
                                Grid.Column="2"
                                Command="{Binding GuardarClienteCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Guardar" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
