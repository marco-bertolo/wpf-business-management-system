<Window x:Class="PapJoaoSimoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PapJoaoSimoes"
        xmlns:viewModels="clr-namespace:PapJoaoSimoes.ViewModels"
        mc:Ignorable="d"
        Title="PAP João - Gestão Comercial"
        Icon="Assets/Plasimoes.ico"
        Width="1180"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="48" />
            <Setter Property="Margin" Value="12,2" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ButtonBackground"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6" />
                            <Border x:Name="SelectedIndicator"
                                    Width="4"
                                    Height="24"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#62D494"
                                    CornerRadius="0,3,3,0"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#234D42" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#28584A" />
                                <Setter TargetName="SelectedIndicator" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationIconStyle" TargetType="TextBlock">
            <Setter Property="Width" Value="32" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="NavigationLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter Margin="9,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBackground" Property="Background" Value="#2A594C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBackground" Property="Background" Value="#326457" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Height="78" Margin="18,16,18,20">
                    <Image MaxWidth="202"
                           MaxHeight="70"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           Source="Assets/LogoPlasimoes.png"
                           Stretch="Uniform" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Margin="24,0,0,10"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#7FA497"
                               Text="MENU PRINCIPAL" />

                    <RadioButton x:Name="DashboardButton"
                                 GroupName="Navigation"
                                 IsChecked="True"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavigationIconStyle}" Text="&#xE80F;" />
                            <TextBlock Style="{StaticResource NavigationLabelStyle}" Text="Painel geral" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Vendas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavigationIconStyle}" Text="&#xE719;" />
                            <TextBlock Style="{StaticResource NavigationLabelStyle}" Text="Vendas" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Produtos">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavigationIconStyle}" Text="&#xE71D;" />
                            <TextBlock Style="{StaticResource NavigationLabelStyle}" Text="Produtos" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Clientes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavigationIconStyle}" Text="&#xE77B;" />
                            <TextBlock Style="{StaticResource NavigationLabelStyle}" Text="Clientes" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Fornecedores">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavigationIconStyle}" Text="&#xE7C9;" />
                            <TextBlock Style="{StaticResource NavigationLabelStyle}" Text="Fornecedores" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Funcionarios">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavigationIconStyle}" Text="&#xE716;" />
                            <TextBlock Style="{StaticResource NavigationLabelStyle}" Text="Funcionários" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Navigation"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="Contas">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavigationIconStyle}" Text="&#xE72E;" />
                            <TextBlock Style="{StaticResource NavigationLabelStyle}" Text="Contas" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="14,8,14,16">
                    <Border Padding="12"
                            Background="#20483D"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="34"
                                    Height="34"
                                    Margin="0,0,10,0"
                                    Background="#2FA66A"
                                    CornerRadius="17">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding InicialUtilizadorAtual}" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="{Binding NomeUtilizadorAtual}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="10.5"
                                           Foreground="#9CB9B0"
                                           Text="{Binding DetalheUtilizadorAtual}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,9,0,0"
                                    Command="{Binding TerminarSessaoCommand}"
                                    Style="{StaticResource SidebarActionButtonStyle}"
                                    ToolTip="Terminar a sessão atual">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="25"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Text="&#xE8AC;" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               Text="Terminar sessão" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Margin="10,10,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,9,0"
                                 VerticalAlignment="Center"
                                 Fill="#62D494" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock FontSize="10.5" Foreground="#8FB4A8" Text="MySQL" />
                            <TextBlock Margin="5,0" FontSize="10.5" Foreground="#587D71" Text="·" />
                            <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="White" Text="PAPJoao" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="82" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="32,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="{Binding PageTitle}" />
                        <TextBlock x:Name="PageSubtitle"
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding PageSubtitle}" />
                    </StackPanel>
                    <TextBlock x:Name="CurrentDateText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding CurrentDate}" />
                </Grid>
            </Border>

            <ContentControl x:Name="PageContent"
                            Grid.Row="1"
                            Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
